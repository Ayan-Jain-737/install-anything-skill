#!/usr/bin/env node
/**
 * install-anything - Universal GitHub Repository & Skill Installer for AI Agent Harnesses
 *
 * Workflow:
 *  Step 1: Check repository's README for the official installation guide (no heavy clone!)
 *  Step 2: Follow what that repository suggests (skills CLI, curl installer, package manager, or build script)
 *  Step 3: Register and synchronize skills globally across all agent harnesses (Antigravity, Open Agents, Claude, Hermes, etc.)
 */

const fs = require('fs');
const path = require('path');
const os = require('os');
const { execSync } = require('child_process');

const { InstallAnythingScanner, EnlightenScanner } = require('../skills/install-anything-installer/scripts/scan-repo');
const { ScriptAdapter } = require('../skills/install-anything-installer/scripts/adapt-install');
const { SkillRegistry } = require('../skills/install-anything-installer/scripts/skill-registry');
const { ReadmeGuide } = require('../skills/install-anything-installer/scripts/readme-guide');
const { SkillFinder } = require('../skills/install-anything-installer/scripts/skill-finder');

class InstallAnythingCLI {
  constructor(options = {}) {
    let pkg = { version: '1.1.2' };
    try {
      pkg = require('../package.json');
    } catch {}
    this.version = pkg.version;
    this.homedir = options.homedir || os.homedir();

    // Prefer ~/.install-anything with fallback to legacy ~/.enlighten
    const newDir = path.join(this.homedir, '.install-anything');
    const legacyDir = path.join(this.homedir, '.enlighten');
    this.stateDir = (!fs.existsSync(newDir) && fs.existsSync(legacyDir)) ? legacyDir : newDir;
    this.enlightenDir = this.stateDir; // backward compatibility
    this.reposDir = path.join(this.stateDir, 'repos');
    this.cacheDir = path.join(this.stateDir, 'cache');
    this.installedRegistry = path.join(this.cacheDir, 'installed.json');

    const ScannerClass = InstallAnythingScanner || EnlightenScanner;
    this.scanner = new ScannerClass({ dryRun: options.dryRun });
    this.adapter = new ScriptAdapter(options);
    this.skillRegistry = new SkillRegistry({ homedir: this.homedir, dryRun: options.dryRun });
    this.readmeGuide = new ReadmeGuide();
    this.finder = new SkillFinder({ homedir: this.homedir });

    this.ensureDirs();
  }

  ensureDirs() {
    for (const dir of [this.stateDir, this.reposDir, this.cacheDir]) {
      if (!fs.existsSync(dir)) {
        try {
          fs.mkdirSync(dir, { recursive: true });
        } catch {}
      }
    }
    if (!fs.existsSync(this.installedRegistry)) {
      try {
        fs.writeFileSync(this.installedRegistry, JSON.stringify({ installations: [] }, null, 2));
      } catch {}
    }
  }

  /**
   * Normalize any repo input (URL, shorthand, or local path)
   */
  normalizeRepoUrl(input) {
    let clean = input.trim();
    if (/^[a-zA-Z0-9_.-]+\/[a-zA-Z0-9_.-]+$/.test(clean)) {
      clean = `https://github.com/${clean}.git`;
    } else if (clean.startsWith('github.com/')) {
      clean = `https://${clean}`;
    }

    let owner = 'unknown';
    let repoName = 'repo-' + Date.now();

    const match = clean.match(/github\.com[/:]([^/]+)\/([^/.]+)(?:\.git)?/i);
    if (match) {
      owner = match[1];
      repoName = match[2];
    } else if (fs.existsSync(clean)) {
      owner = 'local';
      repoName = path.basename(path.resolve(clean));
    }

    const identifier = `${owner}-${repoName}`.replace(/[^a-zA-Z0-9_-]/g, '-').toLowerCase();

    return {
      url: clean,
      owner,
      repoName,
      identifier
    };
  }

  getInstalled() {
    try {
      if (!fs.existsSync(this.installedRegistry)) return [];
      const data = JSON.parse(fs.readFileSync(this.installedRegistry, 'utf8'));
      return data.installations || [];
    } catch {
      return [];
    }
  }

  saveInstalled(list) {
    try {
      fs.writeFileSync(this.installedRegistry, JSON.stringify({ installations: list }, null, 2));
    } catch {}
  }

  ensureClone(norm, targetDir, options = {}) {
    if (options.dryRun) return true;
    if (fs.existsSync(norm.url)) {
      this.skillRegistry.linkOrCopy(path.resolve(norm.url), targetDir);
      return true;
    }
    if (fs.existsSync(targetDir)) {
      if (options.force || !fs.existsSync(path.join(targetDir, '.git'))) {
        fs.rmSync(targetDir, { recursive: true, force: true });
      } else {
        return true;
      }
    }
    const parent = path.dirname(targetDir);
    if (!fs.existsSync(parent)) fs.mkdirSync(parent, { recursive: true });

    try {
      execSync(`git clone --depth 1 "${norm.url}" "${targetDir}"`, {
        stdio: 'pipe',
        timeout: 300000
      });
      return true;
    } catch (e) {
      return false;
    }
  }

  exposeBinaries(targetDir, binaries) {
    const localBin = path.join(this.homedir, '.local', 'bin');
    if (!fs.existsSync(localBin)) {
      try {
        fs.mkdirSync(localBin, { recursive: true });
      } catch {}
    }

    const exposed = [];
    const pkgPath = path.join(targetDir, 'package.json');
    if (fs.existsSync(pkgPath)) {
      try {
        const pkg = JSON.parse(fs.readFileSync(pkgPath, 'utf8'));
        if (typeof pkg.bin === 'string') {
          const binName = pkg.name || path.basename(targetDir);
          const binSrc = path.resolve(targetDir, pkg.bin);
          const binDest = path.join(localBin, binName);
          if (fs.existsSync(binSrc)) {
            try {
              if (fs.existsSync(binDest)) fs.rmSync(binDest, { force: true });
              fs.symlinkSync(binSrc, binDest);
              fs.chmodSync(binSrc, 0o755);
              exposed.push(binName);
            } catch {}
          }
        } else if (pkg.bin && typeof pkg.bin === 'object') {
          for (const [binName, relPath] of Object.entries(pkg.bin)) {
            const binSrc = path.resolve(targetDir, relPath);
            const binDest = path.join(localBin, binName);
            if (fs.existsSync(binSrc)) {
              try {
                if (fs.existsSync(binDest)) fs.rmSync(binDest, { force: true });
                fs.symlinkSync(binSrc, binDest);
                fs.chmodSync(binSrc, 0o755);
                exposed.push(binName);
              } catch {}
            }
          }
        }
      } catch {}
    }

    return exposed;
  }

  executeRepoSuggestions(targetDir, diagnostics, options = {}) {
    if (options.dryRun || options.skipBuild) {
      return { executed: false, commands: [], reason: 'dry_run or skip_build' };
    }

    const commandsRun = [];
    const method = diagnostics.detected?.installMethod;

    try {
      if (['npm', 'yarn', 'pnpm', 'bun'].includes(method) || fs.existsSync(path.join(targetDir, 'package.json'))) {
        let cmd = 'npm install --prefer-offline --no-audit --no-fund';
        if (fs.existsSync(path.join(targetDir, 'pnpm-lock.yaml'))) cmd = 'pnpm install --prefer-offline';
        else if (fs.existsSync(path.join(targetDir, 'yarn.lock'))) cmd = 'yarn install';
        else if (fs.existsSync(path.join(targetDir, 'bun.lockb'))) cmd = 'bun install';

        try {
          execSync(cmd, { cwd: targetDir, stdio: 'pipe', timeout: 120000 });
          commandsRun.push(cmd);
        } catch {
          if (!cmd.startsWith('npm')) {
            try {
              execSync('npm install --prefer-offline --no-audit --no-fund', { cwd: targetDir, stdio: 'pipe', timeout: 120000 });
              commandsRun.push('npm install');
            } catch {}
          }
        }
      }

      if (['pip', 'uv'].includes(method) || fs.existsSync(path.join(targetDir, 'requirements.txt'))) {
        if (fs.existsSync(path.join(targetDir, 'requirements.txt'))) {
          try {
            execSync('pip install --no-cache-dir -r requirements.txt', { cwd: targetDir, stdio: 'pipe', timeout: 120000 });
            commandsRun.push('pip install -r requirements.txt');
          } catch {}
        }
      }

      if (method === 'cargo' || fs.existsSync(path.join(targetDir, 'Cargo.toml'))) {
        try {
          execSync('cargo build --release', { cwd: targetDir, stdio: 'pipe', timeout: 180000 });
          commandsRun.push('cargo build --release');
        } catch {}
      }
    } catch {}

    return { executed: true, commands: commandsRun };
  }

  /**
   * Main install method - README-First Approach
   */
  async install(repoInput, options = {}) {
    const isJson = options.json;
    const norm = this.normalizeRepoUrl(repoInput);

    if (!isJson) {
      console.log(`\n✨ install-anything v${this.version}`);
      console.log(`📦 Target Repository: ${norm.url}`);
      console.log(`🆔 Identifier: ${norm.identifier}\n`);
    }

    // Check existing
    const existing = this.getInstalled().find(i => i.identifier === norm.identifier);
    if (existing && !options.force && !options.dryRun) {
      const msg = `Repository already installed at ${existing.install_dir || existing.repo_url}. Use --force to reinstall.`;
      if (isJson) {
        console.log(JSON.stringify({ status: 'already_installed', identifier: norm.identifier, install_dir: existing.install_dir }, null, 2));
      } else {
        console.log(`⚠️  ${msg}\n`);
      }
      return { status: 'already_installed', identifier: norm.identifier, install_dir: existing.install_dir };
    }

    // =========================================================================
    // STEP 1: Check repository's README first for installation guide
    // =========================================================================
    if (!isJson) console.log(`📖 Step 1/3: Checking repository README for installation guide...`);
    const readmeData = await this.readmeGuide.fetchReadme(norm.url);
    const guide = readmeData
      ? this.readmeGuide.parseInstallGuide(readmeData.content, norm.url)
      : { hasGuide: false, suggestions: [] };

    let executedCommand = null;
    let guideFollowed = false;
    const targetDir = path.join(this.reposDir, norm.owner, norm.repoName);

    // =========================================================================
    // STEP 2: Follow what the repository suggests!
    // =========================================================================
    if (!isJson) console.log(`⚡ Step 2/3: Following repository's suggested installation steps...`);

    if (guide.hasGuide && guide.primarySuggestion && !options.skipGuide) {
      const suggestion = guide.primarySuggestion;
      if (!isJson) {
        console.log(`   💡 Found official guide step: "${suggestion.command}"`);
        console.log(`      Purpose: ${suggestion.description}`);
      }

      if (options.dryRun) {
        if (!isJson) console.log(`   ⚠️ DRY RUN: Would execute "${suggestion.command}"`);
        executedCommand = suggestion.command;
        guideFollowed = true;
      } else {
        // Option A: Skills CLI install (e.g. npx skills add ...)
        if (suggestion.type === 'skills_cli') {
          let cmd = suggestion.command;
          if (!cmd.includes('-y')) cmd += ' -y';
          if (!cmd.includes('-g') && !cmd.includes('--global')) cmd += ' -g';
          try {
            if (!isJson) console.log(`   🚀 Running: ${cmd}`);
            execSync(cmd, { stdio: 'inherit', timeout: 180000 });
            executedCommand = cmd;
            guideFollowed = true;
          } catch (e) {
            if (!isJson) console.log(`   ⚠️ Skills CLI notice: ${e.message}`);
          }
        }
        // Option B: One-liner script installer (curl | bash) or global package install
        else if (['curl_sh', 'npm_global', 'pip', 'cargo'].includes(suggestion.type)) {
          try {
            if (!isJson) console.log(`   🚀 Running: ${suggestion.command}`);
            execSync(suggestion.command, { stdio: 'inherit', timeout: 180000 });
            executedCommand = suggestion.command;
            guideFollowed = true;
          } catch (e) {
            if (!isJson) console.log(`   ⚠️ Command notice: ${e.message}`);
          }
        }
        // Option C: Local script execution (e.g. ./install.sh)
        else if (suggestion.type === 'local_script') {
          this.ensureClone(norm, targetDir, options);
          try {
            if (!isJson) console.log(`   🚀 Running: ${suggestion.command} in ${targetDir}`);
            execSync(suggestion.command, { cwd: targetDir, stdio: 'inherit', timeout: 180000 });
            executedCommand = suggestion.command;
            guideFollowed = true;
          } catch (e) {
            if (!isJson) console.log(`   ⚠️ Local script notice: ${e.message}`);
          }
        }
      }
    }

    // Fallback if no guide command executed (or local repo)
    if (!guideFollowed) {
      if (!isJson) {
        if (guide.hasGuide && guide.primarySuggestion) {
          console.log(`   ℹ️ Guided setup requires interactive terminal; proceeding with direct repository skill installation...`);
        } else {
          console.log(`   ℹ️ No direct installer command in README; checking repository files...`);
        }
      }
      const cloned = this.ensureClone(norm, targetDir, options);
      if (cloned && fs.existsSync(targetDir)) {
        const diagnostics = this.scanner.scanRepo(targetDir);
        this.executeRepoSuggestions(targetDir, diagnostics, options);
        this.exposeBinaries(targetDir, diagnostics.suggestions?.binaries);
      }
    }

    // =========================================================================
    // STEP 3: Register and synchronize skills for the active agent & global storage
    // =========================================================================
    const callerHarness = options.targetHarness || options.harness || options.agent || this.skillRegistry.detectCallerHarness(options);
    const isAllHarnesses = Boolean(options.allHarnesses || options.allAgents);

    if (!isJson) {
      if (callerHarness && !isAllHarnesses) {
        console.log(`🌐 Step 3/3: Registering skills for active agent (${callerHarness}) & global storage...`);
      } else if (isAllHarnesses) {
        console.log(`🌐 Step 3/3: Registering skills across all agent harnesses...`);
      } else {
        console.log(`🌐 Step 3/3: Registering skills globally & in detected harnesses...`);
      }
    }

    // 1. Sync skills from Open Agents (~/.agents/skills) to the active harness
    const syncedSkills = this.skillRegistry.syncAllGlobalSkills({
      targetHarness: callerHarness,
      allHarnesses: isAllHarnesses
    });

    // 2. If targetDir was cloned, check if it has skills or synthesize a skill wrapper
    const registeredSkillsManifest = [];
    if (fs.existsSync(targetDir)) {
      const skillsInRepo = this.skillRegistry.discoverSkills(targetDir);
      if (skillsInRepo.length > 0) {
        for (const s of skillsInRepo) {
          const res = this.skillRegistry.registerSkill(s, {
            repoUrl: norm.url,
            targetHarness: callerHarness,
            allHarnesses: isAllHarnesses
          });
          registeredSkillsManifest.push({
            name: s.name,
            path: s.skillDir,
            registeredHarnesses: res.registeredHarnesses.map(h => h.harness)
          });
        }
      } else if (!guideFollowed) {
        const gen = this.skillRegistry.generateSkillForRepo(targetDir, { name: norm.repoName, repoUrl: norm.url });
        const res = this.skillRegistry.registerSkill(gen, {
          repoUrl: norm.url,
          targetHarness: callerHarness,
          allHarnesses: isAllHarnesses
        });
        registeredSkillsManifest.push({
          name: gen.name,
          path: gen.skillDir,
          registeredHarnesses: res.registeredHarnesses.map(h => h.harness)
        });
      }
    }

    if (!isJson) {
      const allRegistered = new Set();
      registeredSkillsManifest.forEach(m => m.registeredHarnesses.forEach(h => allRegistered.add(h)));
      syncedSkills.forEach(s => allRegistered.add(s.harness));
      if (allRegistered.size === 0) {
        allRegistered.add('Open Agents (~/.agents/skills/)');
      }

      console.log(`   ✅ Skills registered:`);
      for (const h of allRegistered) {
        console.log(`      • ${h}`);
      }
    }

    // Record in registry
    if (!options.dryRun) {
      const installed = this.getInstalled().filter(i => i.identifier !== norm.identifier);
      installed.push({
        identifier: norm.identifier,
        repo_url: norm.url,
        install_dir: fs.existsSync(targetDir) ? targetDir : 'global_skills_cli',
        installed_at: new Date().toISOString(),
        guide_command: executedCommand,
        guide_followed: guideFollowed,
        skills_registered: registeredSkillsManifest,
        skills_synced: syncedSkills.map(s => s.skill),
        version: this.version
      });
      this.saveInstalled(installed);
    }

    const result = {
      status: options.dryRun ? 'dry_run' : 'success',
      identifier: norm.identifier,
      repo_url: norm.url,
      guide_command: executedCommand,
      guide_followed: guideFollowed,
      skills_registered: registeredSkillsManifest,
      skills_synced: syncedSkills.map(s => s.skill)
    };

    if (isJson) {
      console.log(JSON.stringify(result, null, 2));
    } else {
      console.log(`\n🎉 Installation Complete!`);
      if (executedCommand) console.log(`   • Executed Guide Step: ${executedCommand}`);
      if (registeredSkillsManifest.length > 0) {
        console.log(`   • Skills Discovered & Registered: ${registeredSkillsManifest.length}`);
      }
      const harnessNames = new Set();
      registeredSkillsManifest.forEach(m => m.registeredHarnesses.forEach(h => harnessNames.add(h)));
      syncedSkills.forEach(s => harnessNames.add(s.harness));
      if (harnessNames.size === 0) harnessNames.add('Open Agents');
      console.log(`   • Harnesses Updated: ${Array.from(harnessNames).join(', ')}`);
      console.log(`\n💡 The newly installed skills are immediately available to your AI agents!`);
    }

    return result;
  }

  /**
   * Safe removal of any install-anything-managed repository and its registered skills
   */
  uninstall(identifierInput, options = {}) {
    const isJson = options.json;
    const cleanId = identifierInput.trim().toLowerCase();

    const installed = this.getInstalled();
    const item = installed.find(i => i.identifier === cleanId || i.repo_url === identifierInput || i.identifier.endsWith(cleanId));

    if (!item) {
      const errMsg = `No installation found with identifier: "${identifierInput}"`;
      if (isJson) {
        console.log(JSON.stringify({ status: 'not_found', error: errMsg }, null, 2));
      } else {
        console.log(`\n❌ ${errMsg}\n`);
      }
      return { status: 'not_found' };
    }

    if (!isJson) {
      console.log(`\n🗑️  install-anything Uninstaller`);
      console.log(`   Removing: ${item.identifier} (${item.repo_url})`);
    }

    if (options.dryRun) {
      if (!isJson) console.log(`\n⚠️  DRY RUN: No files or skills will be removed.\n`);
      return { status: 'dry_run', target: item.identifier };
    }

    if (!options.force && !isJson) {
      console.log(`\n⚠️  To safely remove this repository and all its registered skills, run:`);
      console.log(`    install-anything uninstall ${item.identifier} --force\n`);
      return { status: 'confirmation_required' };
    }

    // 1. Unregister all skills
    const uninstalledSkills = [];
    if (item.skills_registered && Array.isArray(item.skills_registered)) {
      for (const s of item.skills_registered) {
        const removedFrom = this.skillRegistry.unregisterSkill(s.name);
        uninstalledSkills.push({ name: s.name, removedFrom });
        if (!isJson) console.log(`   • Unregistered skill: "${s.name}"`);
      }
    }

    // 2. Remove repository directory if it exists
    if (item.install_dir && fs.existsSync(item.install_dir) && item.install_dir !== 'global_skills_cli') {
      try {
        fs.rmSync(item.install_dir, { recursive: true, force: true });
        if (!isJson) console.log(`   • Deleted repository directory: ${item.install_dir}`);
      } catch {}
    }

    // 3. Update registry
    const remaining = installed.filter(i => i.identifier !== item.identifier);
    this.saveInstalled(remaining);

    if (isJson) {
      console.log(JSON.stringify({ status: 'success', identifier: item.identifier, uninstalledSkills }, null, 2));
    } else {
      console.log(`\n✅ Successfully uninstalled ${item.identifier}!\n`);
    }

    return { status: 'success', identifier: item.identifier };
  }

  /**
   * List all managed installations
   */
  listInstalled(options = {}) {
    const installed = this.getInstalled();
    if (options.json) {
      console.log(JSON.stringify({ installations: installed }, null, 2));
      return installed;
    }

    console.log(`\n📋 Installed Repositories (${installed.length})\n`);
    if (installed.length === 0) {
      console.log(`No repositories currently installed.`);
      console.log(`Use "install-anything install <repo-url>" to install repositories and register skills.\n`);
      return installed;
    }

    installed.forEach(item => {
      const skills = (item.skills_registered || []).map(s => s.name).join(', ') || 'none';
      const date = item.installed_at ? new Date(item.installed_at).toLocaleString() : 'unknown';
      console.log(`• ${item.identifier}`);
      console.log(`  Repo: ${item.repo_url}`);
      console.log(`  Guide Step: ${item.guide_command || 'default setup'}`);
      console.log(`  Skills: ${skills}`);
      console.log(`  Installed: ${date}\n`);
    });

    return installed;
  }

  /**
   * Diagnose repository without installing - uses README first!
   */
  async diagnose(repoInput, options = {}) {
    const isJson = options.json;
    const norm = this.normalizeRepoUrl(repoInput);

    if (!isJson) {
      console.log(`\n🔍 Diagnosing: ${norm.url}...`);
    }

    // Fetch README without cloning
    const readmeData = await this.readmeGuide.fetchReadme(norm.url);
    const guide = readmeData
      ? this.readmeGuide.parseInstallGuide(readmeData.content, norm.url)
      : { hasGuide: false, suggestions: [] };

    const diag = {
      repository: norm.url,
      identifier: norm.identifier,
      readme: {
        found: !!readmeData,
        source: readmeData?.source || 'not found',
        hasInstallationGuide: guide.hasGuide,
        primarySuggestion: guide.primarySuggestion,
        allSuggestions: guide.suggestions
      }
    };

    if (isJson) {
      console.log(JSON.stringify(diag, null, 2));
    } else {
      console.log(`\n📊 Diagnostic Report:`);
      console.log(`   • README Found: ${diag.readme.found ? 'Yes (' + diag.readme.source + ')' : 'No'}`);
      console.log(`   • Official Installation Guide: ${diag.readme.hasInstallationGuide ? 'Yes' : 'No explicit command'}`);
      if (diag.readme.primarySuggestion) {
        console.log(`   • Recommended Command: ${diag.readme.primarySuggestion.command}`);
        console.log(`   • Type: ${diag.readme.primarySuggestion.type}`);
        console.log(`   • Description: ${diag.readme.primarySuggestion.description}`);
      }
      console.log('');
    }

    return diag;
  }

  /**
   * Search for skills, packages, and tool repositories across registry and curated index
   */
  async findSkills(query, options = {}) {
    const isJson = options.json;
    const results = await this.finder.search(query, options);

    if (isJson) {
      console.log(JSON.stringify({ query, count: results.length, results }, null, 2));
    } else {
      console.log(this.finder.formatOutput(results, query));
    }

    return results;
  }
}

// CLI Execution
function runCLI(rawArgs = process.argv.slice(2)) {
  const args = rawArgs;
  const cli = new InstallAnythingCLI({
    dryRun: args.includes('--dry-run')
  });

  const isJson = args.includes('--json');
  const isForce = args.includes('--force');
  const isDryRun = args.includes('--dry-run');
  const isAllAgents = args.includes('--all') || args.includes('--all-agents') || args.includes('--all-harnesses');

  let targetHarness = null;
  const filteredArgs = [];
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--agent' || args[i] === '--harness' || args[i] === '--for') {
      targetHarness = args[i + 1];
      i++;
    } else if (args[i].startsWith('--agent=')) {
      targetHarness = args[i].slice('--agent='.length);
    } else if (args[i].startsWith('--harness=')) {
      targetHarness = args[i].slice('--harness='.length);
    } else if (args[i].startsWith('--for=')) {
      targetHarness = args[i].slice('--for='.length);
    } else if (!args[i].startsWith('--')) {
      filteredArgs.push(args[i]);
    }
  }

  if (filteredArgs.length === 0 || args.includes('--help') || args.includes('-h') || filteredArgs[0] === 'help') {
    console.log(`
ias (Install Anything Skill) v${cli.version} - Universal AI Agent Repository & Skill Installer

USAGE:
    ias find <query> [--json]
    ias install <repo-url> [--agent <name>] [--all-agents] [--dry-run] [--force] [--json]
    ias diagnose <repo-url> [--json]
    ias list-installed [--json]
    ias uninstall <identifier> [--force] [--dry-run] [--json]
    ias --help
    (alias: install-anything)

COMMANDS:
    find <query>        Discover agent skills, packages, and CLI tool repos (e.g. ias find react)
    install <url>       Check README for install guide, execute suggested steps,
                        and register skills for the active agent harness and global store.
    diagnose <url>      Check README & repository without installing.
    list-installed      Show all managed installations and registered skills.
    uninstall <id>      Safely remove a repository and unregister its skills.

OPTIONS:
    --agent <name>      Explicitly target an agent harness (e.g. gemini, claude, codex, zed)
    --all-agents        Install into all agent harnesses instead of only the active agent
    --dry-run           Simulate installation without making filesystem changes
    --force             Reinstall or overwrite existing installation
    --json              Output results as formatted JSON

WORKFLOW:
    1. Check README     Fetches the README first (no heavy cloning).
    2. Follow Guide     Runs the author's recommended installation command (skills CLI, curl, etc.).
    3. Active & Global  Registers skills in the active agent folder and global store (~/.agents/skills/).
`);
    process.exit(0);
  }

  const cmd = filteredArgs[0].toLowerCase();
  const target = filteredArgs[1];

  (async () => {
    switch (cmd) {
      case 'find':
      case 'search':
        await cli.findSkills(target || '', { json: isJson });
        break;

      case 'install':
        if (!target) {
          console.error('Error: repository URL or shorthand required (e.g., install-anything install owner/repo)');
          process.exit(1);
        }
        await cli.install(target, {
          json: isJson,
          force: isForce,
          dryRun: isDryRun,
          targetHarness,
          allAgents: isAllAgents,
          allHarnesses: isAllAgents
        });
        break;

      case 'diagnose':
        if (!target) {
          console.error('Error: repository URL required');
          process.exit(1);
        }
        await cli.diagnose(target, { json: isJson });
        break;

      case 'list':
      case 'list-installed':
      case 'ls':
        cli.listInstalled({ json: isJson });
        break;

      case 'uninstall':
      case 'remove':
      case 'rm':
        if (!target) {
          console.error('Error: identifier required (use "install-anything list-installed" to see identifiers)');
          process.exit(1);
        }
        cli.uninstall(target, { json: isJson, force: isForce, dryRun: isDryRun });
        break;

      default:
        console.error(`Unknown command: "${cmd}". Run "install-anything --help" for usage.`);
        process.exit(1);
    }
  })();
}

if (require.main === module) {
  runCLI();
}

module.exports = {
  InstallAnythingCLI,
  EnlightCLI: InstallAnythingCLI,
  runCLI
};
